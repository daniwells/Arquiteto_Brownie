{
  "name": "arquiteto_brownie",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate --schema=src/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=src/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=src/prisma/schema.prisma",
    "commit": "git-cz",
    "format": "prettier --write ."
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma",
    "seed": "npx tsx ./src/db/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@commitlint/types": "^19.8.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.0.1",
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "^6.3.1",
    "@types/jest": "^29.5.14",
    "@types/ws": "^8.18.0",
    "axios": "^1.9.0",
    "bcrypt": "^5.1.1",
    "bcrypt-ts-edge": "^3.0.1",
    "bcryptjs": "^3.0.2",
    "cz-emoji-conventional": "^1.2.1",
    "dotenv": "^16.4.7",
    "form-data": "^4.0.2",
    "framer-motion": "^12.6.3",
    "imask": "^7.6.1",
    "jest": "^29.7.0",
    "next": "15.2.4",
    "next-auth": "^5.0.0-beta.25",
    "next-themes": "^0.4.6",
    "node-fetch": "^3.3.2",
    "prettier": "^3.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.56.1",
    "react-imask": "^7.6.1",
    "react-input-mask": "^2.0.4",
    "styled-components": "^6.1.16",
    "swiper": "^11.2.6",
    "ts-jest": "^29.3.1",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "husky": {
    "hooks": {
      "prepare-commit-msg": "exec < /dev/tty && npx cz --hook || true"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/eslintrc": "^3",
    "@prisma/client": "^6.3.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-input-mask": "^3.0.6",
    "babel-plugin-styled-components": "^2.1.4",
    "commitizen": "^4.3.1",
    "commitlint-config-gitmoji": "^2.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9",
    "eslint-config-next": "15.2.4",
    "husky": "^9.1.7",
    "prisma": "^6.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-emoji-conventional",
      "useGitmojis": true
    }
  }
}
